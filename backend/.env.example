# Copy to backend/.env for local development. Never commit .env.
# Every value below is a non-secret default or placeholder.

# development | test | staging | production   (default: production)
ENVIRONMENT=development

# Local development only. Read-only anonymous VIEWER access. Ignored outside development.
ALLOW_ANONYMOUS_VIEWER=false

# Required outside development/test. Comma-separated, no wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLAlchemy URL. Default: a SQLite file in the working directory.
DATABASE_URL=sqlite:///./agent_eval.db

# Reported by /version. Set from your build pipeline in deployed environments.
COMMIT_SHA=unknown
BUILD_DATE=2026-11-08T12:00:00Z
